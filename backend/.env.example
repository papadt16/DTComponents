# Copy this file to .env for local dev, and set the same keys in your
# hosting provider's dashboard (e.g. Render → Environment) for production.
# NEVER commit a real .env file — it's already in .gitignore.

PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/dtcomponents

# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Admin login — generate ADMIN_PASSWORD_HASH with:
#   node scripts/hash-password.js "your-new-strong-password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
