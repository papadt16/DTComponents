# Copy to .env.local for local dev, and set the same key in your
# hosting provider's dashboard (e.g. Vercel/Netlify → Environment Variables).

VITE_API_URL=https://dtcomponents-backend.onrender.com

# Optional: change the admin panel's URL path away from the guessable
# default. This is a minor obscurity layer only — the real protection
# is the backend login. Example: VITE_ADMIN_PATH=/console-7f2a
VITE_ADMIN_PATH=/adminshopaccess
